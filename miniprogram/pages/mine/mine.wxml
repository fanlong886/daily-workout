<!-- 我的页：真实资料 + 菜单入口 -->
<view class="page">
  <!-- 资料卡：user.get / globalData -->
  <view class="card profile-card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-info">
      <view class="nickname">{{nickname}}</view>
      <view class="goal-tag">目标 · {{goal}}</view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="onEditProfile">
      <text>编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="onBadges">
      <text>我的徽章</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="onBodyRecord">
      <text>体重记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="onSharePoster">
      <text>分享海报</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="onReminder">
      <text>每日提醒</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-item" bindtap="onAbout">
      <text>关于</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 每日提醒设置弹层 -->
<reminder-editor visible="{{showReminder}}" bindclose="onReminderClose" />

<!-- 分享海报弹层 -->
<share-poster show="{{showPoster}}" bindclose="onPosterClose" />
