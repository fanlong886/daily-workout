/* 跟练执行页样式：深色沉浸 + 大计时器为唯一视觉重心 */
.workout-page {
  background: var(--color-text);
  color: #FFFFFF;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.workout-head {
  text-align: center;
  margin-bottom: var(--space-lg);
}

.workout-day {
  font-size: var(--font-size-sm);
  color: #FF5C38;
  font-weight: 600;
}

.workout-title {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-size-lg);
  font-weight: 600;
}

/* 计时环：大圆 */
.timer-box {
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 92, 56, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xl);
}

.timer-running {
  border-color: #FF5C38;
  box-shadow: 0 0 40rpx rgba(255, 92, 56, 0.35);
}

.timer-time {
  font-size: 108rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.timer-hint {
  margin-top: var(--space-xs);
  font-size: var(--font-size-xs);
  color: #A6ACBD;
}

/* 动作提示 */
.workout-tips {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-xl);
}

.tips-label {
  font-size: var(--font-size-xs);
  color: #A6ACBD;
}

.tips-text {
  margin-top: var(--space-xs);
  font-size: var(--font-size-sm);
  color: #FFFFFF;
  line-height: 1.7;
}

/* 操作行 */
.workout-actions {
  display: flex;
  gap: var(--space-md);
  width: 100%;
}

.action-quit,
.action-finish {
  flex: 1;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-md);
  line-height: 2.6;
}

.action-quit::after,
.action-finish::after {
  border: none;
}

.action-quit {
  background: rgba(255, 255, 255, 0.08);
  color: #A6ACBD;
}

.action-finish {
  background: #FF5C38;
  color: #FFFFFF;
  font-weight: 600;
}

.btn-disabled {
  opacity: 0.5;
}
