<!-- 跟练执行页：大倒计时 + 暂停/继续 + 完成/放弃 -->
<view class="page workout-page">
  <block wx:if="{{loading}}">
    <view class="placeholder-box">加载中…</view>
  </block>

  <block wx:elif="{{item}}">
    <view class="workout-head">
      <text class="workout-day">Day {{dayNo}}</text>
      <text class="workout-title">{{item.icon}} {{item.title}}</text>
    </view>

    <!-- 计时环 -->
    <view class="timer-box {{running ? 'timer-running' : ''}}" bindtap="onToggleRun">
      <view class="timer-time">{{remainSec >= 3600 ? '' : ''}}{{minutes}}</view>
      <view class="timer-hint">{{finished ? '已完成 ✅' : running ? '点击暂停' : '点击继续'}}</view>
    </view>

    <view class="workout-tips card" wx:if="{{item.tips}}">
      <text class="tips-label">动作提示</text>
      <text class="tips-text">{{item.tips}}</text>
    </view>

    <view class="workout-actions">
      <button class="action-quit" bindtap="onQuit" disabled="{{finished}}">放弃</button>
      <button
        class="btn-primary action-finish {{finishing || finished ? 'btn-disabled' : ''}}"
        bindtap="onFinish"
        disabled="{{finishing || finished}}"
      >
        {{finished ? '已完成' : finishing ? '打卡中…' : '完成打卡'}}
      </button>
    </view>
  </block>
</view>
