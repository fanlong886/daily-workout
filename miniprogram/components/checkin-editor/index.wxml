<!-- 打卡编辑半屏弹层：类型宫格 + 时长步进 + 强度三选 + 备注 -->
<view class="mask" wx:if="{{visible}}" bindtap="onClose">
  <view class="panel" catchtap="noop">
    <view class="panel-header">
      <text class="panel-title">快速打卡</text>
      <text class="panel-close" bindtap="onClose">✕</text>
    </view>

    <view wx:if="{{loading}}" class="panel-loading">加载中…</view>

    <block wx:else>
      <!-- 训练类型宫格 -->
      <view class="section-label">今天练了什么？</view>
      <view class="type-grid">
        <view
          wx:for="{{types}}"
          wx:key="_id"
          class="type-item {{selectedTypeId === item._id ? 'type-item-active' : ''}}"
          data-id="{{item._id}}"
          bindtap="onSelectType"
        >
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 时长步进 -->
      <view class="section-label">练了多久？</view>
      <view class="duration-row">
        <view class="step-btn" bindtap="onDurationMinus">−</view>
        <view class="duration-value">{{duration}}<text class="duration-unit">分钟</text></view>
        <view class="step-btn" bindtap="onDurationPlus">＋</view>
      </view>

      <!-- 强度三选 -->
      <view class="section-label">强度感受</view>
      <view class="intensity-row">
        <view
          wx:for="{{intensities}}"
          wx:key="*this"
          class="intensity-item {{selectedIntensity === item ? 'intensity-active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectIntensity"
        >{{item}}</view>
      </view>

      <!-- 备注（可选） -->
      <input
        class="note-input"
        placeholder="备注一句（可选），如：今天状态不错"
        maxlength="200"
        value="{{note}}"
        bindinput="onNoteInput"
      />

      <!-- 照片（可选）：单张，拍/选皆可 -->
      <view class="section-label">晒一下（可选）</view>
      <view class="photo-row">
        <view wx:if="{{photoPath}}" class="photo-preview-box">
          <image class="photo-preview" src="{{photoPath}}" mode="aspectFill" />
          <view class="photo-remove" catchtap="clearPhoto">✕</view>
        </view>
        <view wx:else class="photo-add" bindtap="choosePhoto">
          <text class="photo-add-icon">📷</text>
          <text class="photo-add-text">拍照 / 相册</text>
        </view>
      </view>

      <!-- 分享到打卡广场：feed 仅展示昵称/类型/时长，不含备注与照片 -->
      <view class="square-row">
        <view class="square-main">
          <text class="square-label">分享到打卡广场</text>
          <text class="square-desc">他人仅可见昵称、训练类型和时长</text>
        </view>
        <switch checked="{{shareToSquare}}" color="#FF5C38" bindchange="onSquareChange" />
      </view>

      <!-- 完成打卡：默认值兜底，0 必填，3 步内的最后一步 -->
      <button class="btn-primary confirm-btn {{submitting ? 'btn-disabled' : ''}}" bindtap="onConfirm" disabled="{{submitting}}">
        {{submitting ? (photoPath ? '上传打卡中…' : '打卡中…') : '完成打卡'}}
      </button>
    </block>
  </view>
</view>
